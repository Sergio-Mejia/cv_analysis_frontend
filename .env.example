# Backend de análisis de hojas de vida.
#
# Sin CV_ANALYSIS_API_URL, el Route Handler `/api/cv/analyze` responde el
# resultado de ejemplo, de modo que el flujo se puede recorrer completo en local.
# Al definirla, el handler reenvía el multipart a esa URL.
#
# Ninguna de las dos lleva el prefijo NEXT_PUBLIC_: solo se leen en el servidor.

CV_ANALYSIS_API_URL=
CV_ANALYSIS_API_TOKEN=
